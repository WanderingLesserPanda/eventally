# Eventally — environment
# Copy to .env and adjust. For docker-compose the DSN host is the compose
# service name "db". For local dev point at your local Postgres.

# Listen address (host:port)
EVENTALLY_ADDR=127.0.0.1:8090

# Postgres DSN (docker-compose: host is the "db" service)
EVENTALLY_DSN=postgres://eventally:***@db:5432/eventally

# Password for the Postgres user (docker-compose only; used by the db
# container and the DSN above). Generate: openssl rand -hex 16
POSTGRES_PASSWORD=change-me

# Secret used to sign session cookies. Generate: openssl rand -hex 32
EVENTALLY_SECRET=change-me-64-hex-chars

# Directory for uploaded receipts and other user files
EVENTALLY_DATA_DIR=./data
