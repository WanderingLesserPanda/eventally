# Eventally — environment
# Copy to .env and adjust.
#
# docker-compose / TrueNAS: only POSTGRES_PASSWORD and EVENTALLY_SECRET
# below are needed — the compose file passes the Postgres connection to
# the app itself via structured EVENTALLY_PG_* variables.
#
# Local dev (running the binary directly): also set the Postgres
# connection variables below.

# Listen address (host:port)
EVENTALLY_ADDR=127.0.0.1:8090

# Postgres connection (local dev). The built-in defaults are
# host=127.0.0.1 port=5432 database=eventally user=eventally — adjust
# only what differs. The structured form is the recommended way: the
# password may contain any character except a single quote
# (8-64 characters; blank = local trust auth).
EVENTALLY_PG_HOST=127.0.0.1
EVENTALLY_PG_PORT=5432
EVENTALLY_PG_DATABASE=eventally
EVENTALLY_PG_USER=eventally
EVENTALLY_PG_PASSWORD=***
# Legacy fallback: URL-form DSN. Cannot carry # % ^ in the password
# (URL parsing breaks or silently corrupts them), so prefer the
# structured variables above — they take precedence when both are set.
#EVENTALLY_DSN=postgres://eventally:***@127.0.0.1:5432/eventally

# Password for the Postgres user (docker-compose only; used by the db
# container and the app's EVENTALLY_PG_PASSWORD).
# 8-64 characters; special characters ! @ # $ % ^ & * + - are supported.
POSTGRES_PASSWORD=change-me

# 256-bit secret, reserved for the future authentik/OIDC layer (not yet
# consumed). Must be exactly 64 hex chars. Generate: openssl rand -hex 32
EVENTALLY_SECRET=change-me-64-hex-chars

# Directory for uploaded receipts and other user files
EVENTALLY_DATA_DIR=./data
