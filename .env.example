# Eventally — environment
# Copy to .env and adjust. For docker-compose the DSN host is the compose
# service name "db". For local dev point at your local Postgres.

# Listen address (host:port)
EVENTALLY_ADDR=127.0.0.1:8090

# Postgres connection. Two equivalent ways:
#   - URL form:  EVENTALLY_DSN (below) — fine for plain passwords.
#   - Structured: EVENTALLY_PG_HOST / _PORT / _DATABASE / _USER / _PASSWORD
#     — REQUIRED if the password contains special characters (! @ # $ % ^
#     & * + -); the URL form cannot carry some of them. Structured values
#     win over the DSN. (docker-compose uses the structured form.)
EVENTALLY_DSN=postgres://eventally:***@db:5432/eventally
#EVENTALLY_PG_HOST=db
#EVENTALLY_PG_PORT=5432
#EVENTALLY_PG_DATABASE=eventally
#EVENTALLY_PG_USER=eventally
#EVENTALLY_PG_PASSWORD=change-me

# Password for the Postgres user (docker-compose only; used by the db
# container and the app's EVENTALLY_PG_PASSWORD above).
# 8-64 characters; special characters ! @ # $ % ^ & * + - are supported.
POSTGRES_PASSWORD=change-me

# 256-bit secret, reserved for the future authentik/OIDC layer (not yet
# consumed). Must be exactly 64 hex chars. Generate: openssl rand -hex 32
EVENTALLY_SECRET=change-me-64-hex-chars

# Directory for uploaded receipts and other user files
EVENTALLY_DATA_DIR=./data
